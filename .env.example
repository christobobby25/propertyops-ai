# Copy to .env and fill in. Config only — no secrets (auth uses gcloud ADC).

# --- Gemini (generation) ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Location for Gemini generation calls (newer models are served from "global").
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash

# --- Data & retrieval ---
# Regional location for embedding calls and for creating the Firestore database.
GOOGLE_CLOUD_REGION=us-central1
# Existing Cloud Storage bucket (bare name) and object prefix for policy Markdown.
GCS_BUCKET=your-bucket-name
GCS_POLICY_PREFIX=policy_docs/
# Firestore database ID. "(default)" is the only one covered by the free tier.
FIRESTORE_DATABASE=(default)

# --- Embeddings (Firestore vectors allow at most 2048 dimensions) ---
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Agent runtime ---
# The agent model is GEMINI_MODEL above.
# "development" enables demo identities (DEV_AUTH_CONTEXT) for local ADK Web only.
# Any other value fails closed: tools refuse to run without a verified identity.
APP_ENV=development
# Demo identity from data/fixtures/demo_auth_contexts.json (development only).
DEV_AUTH_CONTEXT=AUTH-RES-001
TOOL_TIMEOUT_SECONDS=10
MODEL_TIMEOUT_SECONDS=60
AGENT_RUN_TIMEOUT_SECONDS=180
# Per user turn: maximum model calls and tool calls.
MAX_LLM_CALLS=8
MAX_TOOL_CALLS=6
# Live evaluation judge (blank = GEMINI_MODEL).
EVAL_JUDGE_MODEL=
